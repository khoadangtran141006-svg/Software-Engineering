PORT=3001
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/brewlite_db
DB_NAME=brewlite_db
DB_USERNAME=postgres
DB_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
# Đơn chưa thanh toán tự hủy (và hoàn kho) sau số phút này; đặt 0 để tắt
ORDER_EXPIRY_MINUTES=15
# Tài khoản barista để demo đổi trạng thái đơn (để trống nếu không cần)
STAFF_EMAIL=staff@brewlite.local
STAFF_PASSWORD=change-this-staff-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
